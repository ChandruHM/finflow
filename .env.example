# ─── LLM API Keys ───────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ─── LangChain / LangSmith Tracing ─────────────────────
LANGCHAIN_API_KEY=ls-your-langchain-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=finflow-agentic

# ─── MongoDB ────────────────────────────────────────────
MONGODB_URI=mongodb://finflow:finflow_secret@localhost:27017/finflow?authSource=admin
